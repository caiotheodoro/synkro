# Synkro Notification Service Environment Configuration

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
PORT=3005
NODE_ENV=development
WEBSOCKET_PORT=3006

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL Database (for persistent storage - future implementation)
DATABASE_URL=postgresql://user:password@localhost:5432/synkro_notifications

# Redis (for caching and session management - future implementation)
REDIS_URL=redis://localhost:6379

# =============================================================================
# MESSAGE QUEUE CONFIGURATION
# =============================================================================
# RabbitMQ Connection (using logistics-engine credentials)
RABBITMQ_URL=amqp://logistics:logistics_password@localhost:5672

# =============================================================================
# EMAIL PROVIDER CONFIGURATION
# =============================================================================
# SendGrid Configuration
SENDGRID_API_KEY=your_sendgrid_api_key_here
FROM_EMAIL=notifications@synkro.com

# Alternative Email Providers (choose one)
# AWS SES Configuration
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1
# SES_FROM_EMAIL=notifications@synkro.com

# =============================================================================
# PUSH NOTIFICATION CONFIGURATION
# =============================================================================
# Firebase Cloud Messaging (FCM) Configuration
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_firebase_private_key_here\n-----END PRIVATE KEY-----"

# =============================================================================
# SMS PROVIDER CONFIGURATION (Future Implementation)
# =============================================================================
# Twilio Configuration
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_FROM_NUMBER=+1234567890

# =============================================================================
# EXTERNAL SERVICE INTEGRATION
# =============================================================================
# API Gateway for Authentication
API_GATEWAY_URL=http://api-gateway:3000

# Dashboard URLs for email templates
DASHBOARD_URL=https://app.synkro.com
SUPPORT_EMAIL=support@synkro.com

# =============================================================================
# MONITORING & OBSERVABILITY
# =============================================================================
# Prometheus Metrics
PROMETHEUS_PORT=9090

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# JWT Secret for token validation (if implementing direct auth)
# JWT_SECRET=your_jwt_secret_here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# NOTIFICATION CONFIGURATION
# =============================================================================
# Default notification settings
DEFAULT_MAX_RETRY_ATTEMPTS=3
NOTIFICATION_BATCH_SIZE=100
TEMPLATE_CACHE_TTL_MINUTES=60

# WebSocket Configuration
WS_HEARTBEAT_INTERVAL_MS=15000
WS_CLIENT_TIMEOUT_MS=35000

# Push Notification Settings
FCM_BATCH_SIZE=500
PUSH_TOKEN_CLEANUP_HOURS=720

# =============================================================================
# DEVELOPMENT & TESTING
# =============================================================================
# Test Configuration
TEST_MODE=false
MOCK_EXTERNAL_SERVICES=false

# Debug Settings
DEBUG_WEBHOOKS=false
DEBUG_TEMPLATES=false
DEBUG_PUSH_NOTIFICATIONS=false 