---
import Container from "../atoms/Container.astro";
import SectionTitle from "../atoms/SectionTitle.astro";
import BentoGrid, { type BentoItem } from "../molecules/BentoGrid.astro";
import { TrendingUp } from "lucide-astro";

const features = [
  {
    title: "AI-Powered Demand Forecasting",
    description:
      "Python/FastAPI ML service with time series analysis and stock optimization models",
    color: "primary",
    badgeColor: "secondary",
    number: 1,
    colSpan: 1,
    hasPersistentHover: true,
    tags: ["Python", "FastAPI", "ML"],
  },
  {
    title: "Multi-Channel Notifications",
    description:
      "Event-driven Bun/TypeScript service with Email, Push, WebSocket, SMS, and Webhook support",
    color: "secondary",
    badgeColor: "primary",
    number: 2,
    colSpan: 2,
    tags: ["Bun", "RabbitMQ", "Multi-channel"],
  },
  {
    title: "Comprehensive Inventory Tracking",
    description:
      "Track inventory levels, reservations, and transactions across multiple warehouses",
    color: "accent",
    badgeColor: "secondary",
    number: 3,
    colSpan: 2,
    tags: ["PostgreSQL", "Multi-warehouse"],
  },
  {
    title: "Order Processing & Management",
    description:
      "Complete order lifecycle management with status tracking and fulfillment",
    color: "primary",
    badgeColor: "accent",
    number: 4,
    tags: ["Orders", "Fulfillment"],
  },
  {
    title: "Real-Time WebSocket Updates",
    description:
      "Live inventory updates and notifications with WebSocket connections",
    color: "secondary",
    badgeColor: "primary",
    number: 5,
    tags: ["WebSocket", "Real-time"],
  },
  {
    title: "Role-Based Access Control",
    description:
      "NestJS API Gateway with OAuth2/JWT authentication and multi-tenant support",
    color: "accent",
    badgeColor: "secondary",
    number: 6,
    colSpan: 2,
    tags: ["NestJS", "OAuth2", "RBAC"],
  },
] as BentoItem[];
---

<section id="features" class="py-16 bg-white border-b-[3px] border-black">
  <Container>
    <SectionTitle text="Primary Features" />
    <BentoGrid items={features} />
  </Container>
</section>
