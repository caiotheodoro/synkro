---
import Container from "../atoms/Container.astro";
import SectionTitle from "../atoms/SectionTitle.astro";
import Card from "../atoms/Card.astro";
---

<section id="architecture" class="py-16 bg-primary border-b-[3px] border-black">
  <Container>
    <SectionTitle text="Technical Architecture" color="white" />

    <Card
      class="mb-12"
      headerColor="secondary"
      headerText="Frontend Layer (Multi-App Architecture)"
    >
      <ul class="list-disc pl-5 space-y-2">
        <li>
          <strong>Next.js Dashboard:</strong> Main inventory management interface
          with Atomic Design and Neobrutalism styling
        </li>
        <li>
          <strong>Vite Auth Frontend:</strong> Secure authentication and user registration
          flows
        </li>
        <li>
          <strong>Astro Landing:</strong> Fast, static site generation for marketing
          and product information
        </li>
      </ul>
    </Card>

    <Card headerColor="accent" headerText="Backend Microservices">
      <div class="overflow-x-auto">
        <table class="min-w-full border-[3px] border-black">
          <thead>
            <tr class="bg-secondary">
              <th
                class="py-2 px-4 border-b-[3px] border-r-[3px] border-black text-left"
                >Service</th
              >
              <th
                class="py-2 px-4 border-b-[3px] border-r-[3px] border-black text-left"
                >Technology</th
              >
              <th class="py-2 px-4 border-b-[3px] border-black text-left"
                >Purpose</th
              >
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="py-2 px-4 border-b-[3px] border-r-[3px] border-black"
                >API Gateway & Auth</td
              >
              <td class="py-2 px-4 border-b-[3px] border-r-[3px] border-black"
                >NestJS</td
              >
              <td class="py-2 px-4 border-b-[3px] border-black"
                >OAuth2/JWT authentication, RBAC authorization, and API routing</td
              >
            </tr>
            <tr>
              <td class="py-2 px-4 border-b-[3px] border-r-[3px] border-black"
                >AI/ML Service</td
              >
              <td class="py-2 px-4 border-b-[3px] border-r-[3px] border-black"
                >Python (FastAPI)</td
              >
              <td class="py-2 px-4 border-b-[3px] border-black"
                >Demand forecasting, time series analysis, and stock
                optimization models</td
              >
            </tr>
            <tr>
              <td class="py-2 px-4 border-r-[3px] border-black"
                >Notification Service</td
              >
              <td class="py-2 px-4 border-r-[3px] border-black"
                >Bun/TypeScript</td
              >
              <td class="py-2 px-4 border-black"
                >Event-driven multi-channel notifications (Email, Push,
                WebSocket, SMS, Webhooks)</td
              >
            </tr>
          </tbody>
        </table>
      </div>
    </Card>
  </Container>
</section>
