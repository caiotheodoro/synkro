---
import Container from "../atoms/Container.astro";
import SectionTitle from "../atoms/SectionTitle.astro";
import Card from "../atoms/Card.astro";
---

<section id="tech-stack" class="py-16 bg-secondary border-b-[3px] border-black">
  <Container>
    <SectionTitle text="Technology Stack" />

    <div class="grid md:grid-cols-2 gap-8">
      <!-- Communication Layer -->
      <Card headerColor="primary" headerText="Communication & Integration">
        <ul class="list-disc pl-5 space-y-2">
          <li>
            <strong>RabbitMQ:</strong> Event-driven architecture for multi-channel
            notifications and async processing
          </li>
          <li>
            <strong>REST APIs:</strong> Standardized HTTP endpoints for all microservices
            communication
          </li>
          <li>
            <strong>WebSockets:</strong> Real-time inventory updates and live notifications
          </li>
          <li>
            <strong>Firebase FCM:</strong> Push notifications for mobile and web
            applications
          </li>
        </ul>
      </Card>

      <!-- Data Storage -->
      <Card headerColor="accent" headerText="Data Storage & Management">
        <ul class="list-disc pl-5 space-y-2">
          <li>
            <strong>PostgreSQL:</strong> Primary database for inventory, orders,
            users, and ML predictions
          </li>
          <li>
            <strong>Redis:</strong> Caching layer for sessions, tokens, and real-time
            data
          </li>
          <li>
            <strong>Elasticsearch:</strong> Analytics, search capabilities, and log
            aggregation
          </li>
        </ul>
      </Card>

      <!-- Observability Stack -->
      <Card
        class="md:col-span-2"
        headerColor="secondary"
        headerText="Observability & Monitoring"
      >
        <ul class="list-disc pl-5 space-y-2 md:columns-3">
          <li>
            <strong>Metrics:</strong> Prometheus + Grafana for performance monitoring
            and visualization across all services
          </li>
          <li>
            <strong>Logging:</strong> ELK Stack (Elasticsearch, Logstash, Kibana)
            for centralized logging and analysis
          </li>
          <li>
            <strong>Tracing:</strong> Jaeger for distributed tracing and microservice
            interaction monitoring
          </li>
          <li>
            <strong>Health Checks:</strong> Comprehensive health monitoring with
            automatic service discovery
          </li>
          <li>
            <strong>Alerting:</strong> Real-time alerts for system issues and threshold
            breaches
          </li>
        </ul>
      </Card>
    </div>
  </Container>
</section>
